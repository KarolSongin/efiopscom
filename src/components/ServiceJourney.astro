---
import Icon from './Icon.astro';
import '../styles/process.css';
import '../styles/service-journey.css';
interface Journey {
  heading: string;
  example: string;
  sources: string[];
  question: string;
  scope: string[];
  boundary: string;
  build: string[];
  stages: { id: string; label: string; title: string; body: string; output: string }[];
  tests: { label: string; input: string; result: string; reason: string }[];
  handover: { title: string; body: string }[];
}
interface Props {
  journey: Journey;
  service: string;
}
const { journey, service } = Astro.props;
const names = [
  'The starting point',
  'The agreed scope',
  'A view to review',
  'The checks that matter',
  'Ready for everyday use',
];
const icons = ['search', 'sliders', 'grid', 'shield', 'box'];
---

<section
  class="service-journey"
  data-service-journey={service}
  aria-labelledby="service-journey-heading"
>
  <div class="container journey-intro">
    <p class="eyebrow">How this service works</p>
    <div>
      <h2 id="service-journey-heading">{journey.heading}</h2>
      <p>
        {journey.example}
        <span>Follow the example through five stages, with a clear output at each step.</span>
      </p>
    </div>
    <nav class="journey-navigation" aria-label="Service project stages">
      {journey.stages.map((stage, i) => (
        <a href={`#service-${stage.id}`}>
          <span>0{i + 1}</span>
          {stage.label}
          <Icon name="down" size={14} />
        </a>
      ))}
    </nav>
  </div>
  {journey.stages.map((stage, i) => (
    <section
      id={`service-${stage.id}`}
      class:list={[
        'journey-stage',
        { 'journey-stage-reverse': i % 2 === 1, 'journey-stage-dark': stage.id === 'test' },
      ]}
      data-journey-stage={stage.id}
    >
      <div class="container journey-stage-grid">
        <div class="journey-story">
          <p class="eyebrow">
            <span class="project-stage-number">0{i + 1}</span>
            {stage.label}
          </p>
          <h3>{stage.title}</h3>
          <p>{stage.body}</p>
          <div class="project-output">
            <span class="ui-label">What you take away</span>
            <p>{stage.output}</p>
          </div>
        </div>
        <div class="process-art">
          <div class="process-orbit" aria-hidden="true"></div>
          <div class="process-sphere" aria-hidden="true"></div>
          <div class="process-card physical-card" data-journey-card={stage.id}>
            <div class="process-card-header">
              <span class="tile-icon">
                <Icon name={icons[i]} />
              </span>
              <div>
                <span class="ui-label">{names[i]}</span>
                <strong>
                  {stage.id === 'understand'
                    ? 'Start with the inputs.'
                    : stage.id === 'agree'
                      ? 'A focused first result.'
                      : stage.id === 'build'
                        ? 'Make the work visible.'
                        : stage.id === 'test'
                          ? 'The condition changes the decision.'
                          : 'The result comes with context.'}
                </strong>
              </div>
            </div>
            {stage.id === 'understand' && (
              <>
                <div class="journey-sources">
                  {journey.sources.map((source, j) => (
                    <div>
                      <span class="journey-source-number">0{j + 1}</span>
                      <Icon name={['file', 'link', 'sliders'][j]} size={18} />
                      <strong>{source}</strong>
                    </div>
                  ))}
                </div>
                <div class="journey-source-link" aria-hidden="true">
                  <Icon name="down" size={22} />
                </div>
                <div class="journey-question">
                  <span class="ui-label">The question to resolve</span>
                  <strong>{journey.question}</strong>
                </div>
              </>
            )}
            {stage.id === 'agree' && (
              <>
                <ul class="scope-list">
                  {journey.scope.map((item) => (
                    <li>
                      <Icon name="check" size={17} />
                      {item}
                    </li>
                  ))}
                </ul>
                <div class="scope-boundary">
                  <span class="ui-label">Keep the boundaries clear</span>
                  <p>{journey.boundary}</p>
                </div>
                <div class="process-card-foot">
                  <Icon name="link" size={16} />
                  <span>Confirm access, dependencies and costs before work starts.</span>
                </div>
              </>
            )}
            {stage.id === 'build' && (
              <>
                <div class="journey-workspace">
                  <div class="journey-workspace-top">
                    <span class="browser-beads" aria-hidden="true">
                      <i></i>
                      <i></i>
                      <i></i>
                    </span>
                    <span>First working view</span>
                  </div>
                  <div class="journey-build-items">
                    {journey.build.map((item, j) => (
                      <div>
                        <span>0{j + 1}</span>
                        <strong>{item}</strong>
                      </div>
                    ))}
                  </div>
                  <div class="journey-review-state">
                    <Icon name="message" size={17} />
                    <span>Review together → refine the important details</span>
                  </div>
                </div>
                <div class="process-note">
                  <Icon name="check" size={18} />
                  <div>
                    <strong>Check it against the purpose</strong>
                    <p>Does this view make the next decision clearer for the person using it?</p>
                  </div>
                </div>
              </>
            )}
            {stage.id === 'test' && (
              <div data-journey-tests data-test-cases={JSON.stringify(journey.tests)}>
                <div class="test-choice js-only" role="group" aria-label="Choose a project test">
                  {journey.tests.map((test, j) => (
                    <button data-journey-test={j} aria-pressed={j === 0 ? 'true' : 'false'}>
                      {test.label}
                    </button>
                  ))}
                </div>
                <div class="journey-test-input">
                  <span class="ui-label">The input or condition</span>
                  <strong data-journey-test-input>{journey.tests[0].input}</strong>
                </div>
                <div class="test-outcome" role="status" aria-live="polite">
                  <span class="tile-icon">
                    <Icon name="shield" />
                  </span>
                  <div>
                    <span class="ui-label">Expected result</span>
                    <strong data-journey-test-result>{journey.tests[0].result}</strong>
                    <p data-journey-test-reason>{journey.tests[0].reason}</p>
                  </div>
                </div>
                <div class="process-card-foot">
                  <Icon name="file" size={16} />
                  <span>Agree the check. Inspect the result. Keep exceptions visible.</span>
                </div>
                <noscript>
                  <div class="journey-static-tests">
                    {journey.tests.slice(1).map((test) => (
                      <div>
                        <strong>
                          {test.label}: {test.result}
                        </strong>
                        <p>
                          {test.input}. {test.reason}
                        </p>
                      </div>
                    ))}
                  </div>
                </noscript>
              </div>
            )}
            {stage.id === 'handover' && (
              <>
                <div class="handover-files">
                  {journey.handover.map((item) => (
                    <details>
                      <summary>
                        <span class="handover-file-icon">
                          <Icon name="file" size={20} />
                        </span>
                        <strong>{item.title}</strong>
                        <Icon name="plus" size={16} />
                      </summary>
                      <p>{item.body}</p>
                    </details>
                  ))}
                </div>
                <div class="handover-next">
                  <span class="ui-label">The next step</span>
                  <strong>
                    Know how to use it.
                    <br />
                    Know who owns it.
                  </strong>
                  <p>Maintenance and continuing support are agreed around the project.</p>
                </div>
              </>
            )}
          </div>
        </div>
      </div>
    </section>
  ))}
  <div class="container journey-next">
    <p>See the wider approach to scope, collaboration and handover.</p>
    <a class="text-link" href="/how-it-works/">
      How we work together
      <Icon name="arrow" size={18} />
    </a>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-journey-tests]').forEach((root) => {
    const cases = JSON.parse(root.dataset.testCases!) as {
      label: string;
      input: string;
      result: string;
      reason: string;
    }[];
    root.querySelectorAll<HTMLButtonElement>('[data-journey-test]').forEach((button) =>
      button.addEventListener('click', () => {
        const test = cases[Number(button.dataset.journeyTest)];
        root
          .querySelectorAll('[data-journey-test]')
          .forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        for (const field of ['input', 'result', 'reason'] as const)
          root.querySelector(`[data-journey-test-${field}]`)!.textContent = test[field];
      }),
    );
  });
</script>
