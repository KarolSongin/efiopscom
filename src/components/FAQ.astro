---
interface Props {
  items: { question: string; answer: string }[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="container section faq-section">
    <div>
      <p class="eyebrow">A few useful answers</p>
      <h2>
        Questions before
        <br />
        the first conversation.
      </h2>
    </div>
    <div class="faq-list">
      {items.map((item) => (
        <details>
          <summary>
            {item.question}
            <span aria-hidden="true">+</span>
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}
