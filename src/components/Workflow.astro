---
import experience from '../data/experience.json';
import ScenarioCard from './ScenarioCard.astro';
import Icon from './Icon.astro';
const data = experience.playground;
---

<section class="working-day" id="working-day">
  <div class="working-day-glow" aria-hidden="true"></div>
  <div class="container section">
    <div class="working-day-heading">
      <p class="eyebrow">Try a different way of working</p>
      <h2>{data.heading}</h2>
      <p>{data.body}</p>
    </div>
    <div class="working-tabs js-only" role="tablist" aria-label="Explore a business situation">
      {data.tabs.map((tab, i) => (
        <button
          id={`tab-${tab.key}`}
          role="tab"
          aria-controls={`panel-${tab.key}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-work-tab={tab.key}
        >
          <span>0{i + 1}</span>
          {tab.label}
          <Icon name="arrow" size={16} />
        </button>
      ))}
    </div>
    {data.tabs.map((tab, i) => (
      <div
        class:list={['working-panel', { 'initial-panel': i === 0 }]}
        id={`panel-${tab.key}`}
        role="tabpanel"
        aria-labelledby={`tab-${tab.key}`}
        data-work-panel={tab.key}
        tabindex="0"
      >
        <div class="working-story">
          <p class="eyebrow">{tab.eyebrow}</p>
          <h3>{tab.title}</h3>
          <p>{tab.body}</p>
          <a class="text-link" href={tab.href}>
            {tab.link}
            <Icon name="arrow" size={18} />
          </a>
          <div class="working-detail">
            <span class="detail-line"></span>
            <span>
              A clearer input.
              <br />A useful next decision.
            </span>
          </div>
        </div>
        <div class="working-visual">
          <ScenarioCard kind={tab.kind} />
        </div>
      </div>
    ))}
  </div>
</section>
<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-work-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-work-panel]')];
  function activate(tab: HTMLButtonElement) {
    tabs.forEach((button) => {
      const selected = button === tab;
      button.setAttribute('aria-selected', String(selected));
      button.tabIndex = selected ? 0 : -1;
    });
    panels.forEach((panel) => {
      panel.classList.toggle('initial-panel', panel.dataset.workPanel === tab.dataset.workTab);
      panel.hidden = panel.dataset.workPanel !== tab.dataset.workTab;
    });
  }
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => activate(tab));
    tab.addEventListener('keydown', (e) => {
      let index = i;
      if (e.key === 'ArrowRight') index = (i + 1) % tabs.length;
      else if (e.key === 'ArrowLeft') index = (i + tabs.length - 1) % tabs.length;
      else if (e.key === 'Home') index = 0;
      else if (e.key === 'End') index = tabs.length - 1;
      else return;
      e.preventDefault();
      activate(tabs[index]);
      tabs[index].focus();
    });
  });
  if (tabs.length) activate(tabs[0]);
</script>
