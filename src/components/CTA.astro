---
import shared from '../data/shared.json';
import Icon from './Icon.astro';
interface Props {
  heading?: string;
  text?: string;
  label?: string;
  service?: string;
}
const {
  heading = shared.finalCTA.heading,
  text = shared.finalCTA.text,
  label = shared.primaryCTA,
  service,
} = Astro.props;
---

<section class="cta-section">
  <div class="cta-ring" aria-hidden="true"></div>
  <div class="container cta-inner">
    <div>
      <p class="eyebrow">The next useful conversation</p>
      <h2>{heading}</h2>
      <p>{text}</p>
      <a class="button" href={'/contact/' + (service ? '?service=' + service : '')}>
        {label}
        <Icon name="arrow" size={19} />
      </a>
    </div>
    <div class="cta-prompt">
      <span class="ui-label">Start with what needs to change</span>
      <a href="/contact/?service=power-bi">
        <span>A report I keep rebuilding</span>
        <Icon name="arrow" size={18} />
      </a>
      <a href="/contact/?service=power-automate">
        <span>A task I keep repeating</span>
        <Icon name="arrow" size={18} />
      </a>
      <a href="/contact/?service=web-design-development">
        <span>A website we’ve outgrown</span>
        <Icon name="arrow" size={18} />
      </a>
      <a href="/contact/">
        <span>Something else entirely</span>
        <Icon name="arrow" size={18} />
      </a>
    </div>
  </div>
</section>
