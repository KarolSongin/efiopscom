---
interface Props {
  kind: string;
}
const { kind } = Astro.props;
const workflows: Record<string, { title: string; steps: string[]; note: string }> = {
  'power-automate': {
    title: 'An everyday workflow',
    steps: [
      'Trigger · review due',
      'Condition · recipient known',
      'Action · send reminder',
      'Review · missing recipient',
    ],
    note: 'Exceptions stay visible.',
  },
  'ai-assistants': {
    title: 'A request, with boundaries',
    steps: [
      '“What is the job status?”',
      'Authorised source · approved records',
      'Answer · source referenced',
      'Human handover · unresolved request',
    ],
    note: 'Access rules stay in the application.',
  },
  'jev-ai-integration': {
    title: 'One request. A defined route.',
    steps: [
      'State · stock question',
      'Decision · stock information',
      'Application rules · access check',
      'Lookup / clarification / human review',
    ],
    note: 'A route is not an authorisation.',
  },
  'system-integrations': {
    title: 'A dependable handoff',
    steps: [
      'Source · structured export',
      'Mapping · item → product; qty → quantity',
      'Output · reporting records',
      'Exception tray · missing item code',
    ],
    note: 'Repeated and interrupted transfers are checked.',
  },
};
const flow = workflows[kind];
---

<figure class="service-visual">
  <div class="visual-surface">
    <div class="visual-heading">
      <span class="panel-icon" aria-hidden="true">
        {kind === 'computer-vision' ? '⌖' : kind === 'seo' ? '⌕' : kind === 'power-bi' ? '▥' : '⇄'}
      </span>
      <span>
        {flow?.title ||
          {
            'power-bi': 'A useful reporting view',
            'custom-business-apps': 'One place for the work',
            'web-design-development': 'A clearer business website',
            'website-optimisation': 'An easier enquiry journey',
            seo: 'Pages with a purpose',
            'computer-vision': 'A defined visual task',
          }[kind]}
      </span>
    </div>
    {flow && (
      <>
        <ol class="diagram-steps">
          {flow.steps.map((s, i) => (
            <li>
              <span class="step-number">{i + 1}</span>
              <strong>{s}</strong>
              {i === 3 && <span class="review-label">Review</span>}
            </li>
          ))}
        </ol>
        <p class="diagram-note">{flow.note}</p>
      </>
    )}
    {kind === 'power-bi' && (
      <>
        <div class="chart-heading">
          <strong>Example production plan</strong>
          <span>Units · Week 1–4</span>
        </div>
        <svg
          viewBox="0 0 360 140"
          role="img"
          aria-label="Fictional planned units: Week 1 40, Week 2 60, Week 3 50, Week 4 80."
        >
          <g stroke="#CCE2FF">
            <path d="M35 20H345M35 60H345M35 100H345" />
          </g>
          <g fill="#446084" font-size="11">
            <text x="4" y="24">
              80
            </text>
            <text x="4" y="64">
              40
            </text>
            <text x="12" y="104">
              0
            </text>
            <text x="46" y="130">
              W1
            </text>
            <text x="130" y="130">
              W2
            </text>
            <text x="216" y="130">
              W3
            </text>
            <text x="305" y="130">
              W4
            </text>
          </g>
          <path
            d="M55 60L140 40L225 50L315 20"
            stroke="#188BF6"
            stroke-width="5"
            fill="none"
            stroke-linecap="round"
          />
          <g fill="#082F49">
            <circle cx="55" cy="60" r="5" />
            <circle cx="140" cy="40" r="5" />
            <circle cx="225" cy="50" r="5" />
            <circle cx="315" cy="20" r="5" />
          </g>
        </svg>
        <table>
          <caption>Fictional week 4 comparison</caption>
          <thead>
            <tr>
              <th>Measure</th>
              <th>Units</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Planned</td>
              <td>80</td>
            </tr>
            <tr>
              <td>Actual</td>
              <td>72</td>
            </tr>
          </tbody>
        </table>
        <p class="diagram-note">Planned = scheduled units. Actual = recorded output.</p>
      </>
    )}
    {kind === 'custom-business-apps' && (
      <div class="app-screens">
        <div>
          <span class="micro">FORECAST INPUT</span>
          <strong>Example week</strong>
          <div class="fake-field">
            Planned volume <b>80 units</b>
          </div>
        </div>
        <div>
          <span class="micro">CAPACITY VIEW</span>
          <strong>Check the plan</strong>
          <div class="capacity-bar">
            <span></span>
          </div>
          <small>Compare demand with available capacity</small>
        </div>
        <div>
          <span class="micro">REVIEW QUEUE</span>
          <strong>Material check</strong>
          <span class="review-label">Needs review</span>
        </div>
      </div>
    )}
    {kind === 'web-design-development' && (
      <div class="website-frames">
        <div class="desktop-frame">
          <div class="browser-dots">● ● ●</div>
          <div class="mock-site">
            <span class="micro">YOUR BUSINESS</span>
            <strong>
              A clearer offer.
              <br />A useful next step.
            </strong>
            <span class="mock-button">Get in touch →</span>
            <div class="mock-columns">
              <i></i>
              <i></i>
              <i></i>
            </div>
          </div>
        </div>
        <div class="phone-frame">
          <span class="micro">YOUR BUSINESS</span>
          <strong>
            Clear on
            <br />
            every screen.
          </strong>
          <div class="phone-art"></div>
          <span class="mock-button">Get in touch</span>
        </div>
      </div>
    )}
    {kind === 'website-optimisation' && (
      <div class="journey">
        <div>
          <span class="micro">BEFORE · EXAMPLE</span>
          <div class="journey-page">
            <span>Find the offer</span>
            <i></i>
            <i></i>
            <i></i>
            <span>Look for contact</span>
          </div>
        </div>
        <span class="journey-arrow" aria-hidden="true">
          →
        </span>
        <div>
          <span class="micro">AFTER · EXAMPLE</span>
          <div class="journey-page improved">
            <strong>Understand the offer</strong>
            <p>Know the next step.</p>
            <span class="mock-button">Make an enquiry</span>
          </div>
        </div>
      </div>
    )}
    {kind === 'seo' && (
      <>
        <div class="search-preview">
          <span class="micro">SEARCH RESULT PREVIEW</span>
          <span>efiops.com › services › seo</span>
          <strong>SEO Services in Maidstone & Kent | EFIops</strong>
          <p>Technical SEO, clearer service pages and practical local-search improvements.</p>
        </div>
        <div class="site-map">
          <div>Service page</div>
          <span aria-hidden="true">↙ ↘</span>
          <div class="map-children">
            <span>Supporting article*</span>
            <span>Case study*</span>
          </div>
        </div>
        <p class="diagram-note">
          *When reviewed and approved. Search engines may display different text.
        </p>
      </>
    )}
    {kind === 'computer-vision' && (
      <>
        <div class="vision-camera">
          <div class="vision-object"></div>
          <div class="measurement">
            <span>Example measurement overlay</span>
          </div>
          <span class="vision-corner">Controlled image</span>
        </div>
        <div class="vision-output">
          <span>Camera input → Analysis → Review</span>
        </div>
        <p class="diagram-note">Original illustration; overlays are not model predictions.</p>
      </>
    )}
  </div>
  <figcaption>Illustrative example · fictional data</figcaption>
</figure>
