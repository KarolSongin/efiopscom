---
import ScenarioCard from './ScenarioCard.astro';
interface Props {
  kind: string;
}
const { kind } = Astro.props;
---

<div class="service-scene">
  <div class="service-scene-orbit" aria-hidden="true"></div>
  <div class="service-scene-sphere" aria-hidden="true"></div>
  <ScenarioCard kind={kind} />
  <div class="service-scene-base" aria-hidden="true"></div>
</div>
