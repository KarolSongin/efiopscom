---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Directory from '../components/Directory.astro';
import SystemVisual from '../components/SystemVisual.astro';
import ScenarioCard from '../components/ScenarioCard.astro';
import Workflow from '../components/Workflow.astro';
import Icon from '../components/Icon.astro';
import core from '../data/core.json';
import experience from '../data/experience.json';
const page = core.home;
const problems = page.sections[0];
const process = page.sections[5];
const split = (text: string) => {
  const i = text.indexOf('. ');
  return [text.slice(0, i + 1), text.slice(i + 2)];
};
---

<Base title={page.seoTitle} description={page.metaDescription}>
  <section class="hero hero-elevated">
    <div class="hero-halo" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-kicker">
            <span></span>
            {page.eyebrow}
          </p>
          <h1>
            Good business.<span>Better systems.</span>
          </h1>
          <p class="hero-lead">{page.lead}</p>
          <div class="hero-buttons">
            <a href="/contact/" class="button">
              Talk through your project
              <Icon name="arrow" size={19} />
            </a>
            <a href="#working-day" class="button secondary">
              See what’s possible
              <Icon name="down" size={18} />
            </a>
          </div>
          <div class="hero-person">
            <span class="avatar-monogram">KS</span>
            <div>
              <strong>Work directly with Karol.</strong>
              <span>Operations. Data. Hands-on development.</span>
            </div>
          </div>
        </div>
        <SystemVisual />
      </div>
      <div class="hero-footer">
        <span>Based in Maidstone. Working across the UK.</span>
        <div>
          <a href="/services/web-design-development/">Websites</a>
          <i></i>
          <a href="/services/power-bi/">Data</a>
          <i></i>
          <a href="/services/power-automate/">Automation</a>
          <i></i>
          <a href="/services/ai-assistants/">AI in your systems</a>
        </div>
      </div>
    </div>
  </section>
  <section class="container section familiar-section">
    <div class="section-title">
      <div>
        <p class="eyebrow">The friction behind the screen</p>
        <h2>{problems.heading}</h2>
      </div>
      <p>The business works. The tools could work better.</p>
    </div>
    <div class="familiar-grid">
      {problems.paragraphs.map((text, i) => {
        const [title, body] = split(text);
        return (
          <article>
            <div class:list={['friction-art', `friction-${i}`]} aria-hidden="true">
              {i === 0 ? (
                <>
                  <div class="file-slip">
                    <Icon name="file" size={18} />
                    <span>Orders.xlsx</span>
                    <i>134 rows</i>
                  </div>
                  <div class="file-slip">
                    <Icon name="file" size={18} />
                    <span>Sales export.csv</span>
                    <i>5 columns</i>
                  </div>
                  <div class="file-slip">
                    <Icon name="file" size={18} />
                    <span>Which total is right?</span>
                    <i>Review</i>
                  </div>
                </>
              ) : i === 1 ? (
                <>
                  <div class="reminder-slip">
                    <Icon name="mail" />
                    <div>
                      <strong>Re: the quote</strong>
                      <span>Did anyone follow this up?</span>
                    </div>
                  </div>
                  <div class="reminder-bubble">
                    <Icon name="clock" size={17} />
                    One more thing to remember.
                  </div>
                </>
              ) : (
                <div class="friction-browser">
                  <span>
                    <i></i>
                    <i></i>
                    <i></i>
                  </span>
                  <div>
                    <strong>What do you do?</strong>
                    <p>Where do I go next?</p>
                    <b>Keep looking…</b>
                  </div>
                </div>
              )}
            </div>
            <span class="index">0{i + 1}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        );
      })}
    </div>
  </section>
  {experience.features.map((feature, i) => (
    <section class:list={['feature-section', { 'feature-dark': i === 1, 'feature-web': i === 2 }]}>
      <div class:list={['container section feature-row', { 'feature-reverse': i === 1 }]}>
        <div class="feature-art">
          <span class="feature-orbit" aria-hidden="true"></span>
          <ScenarioCard kind={feature.kind} />
          <div class="feature-floating-note">
            <Icon name={i === 0 ? 'chart' : i === 1 ? 'workflow' : 'globe'} size={18} />
            <span>
              {i === 0
                ? 'The question behind the number.'
                : i === 1
                  ? 'The rule behind the next step.'
                  : 'The person behind the visit.'}
            </span>
          </div>
        </div>
        <div class="feature-copy">
          <p class="eyebrow">
            {feature.number} / {feature.label}
          </p>
          <h2>{feature.heading}</h2>
          <p>{feature.body}</p>
          <ul class="benefit-list">
            {feature.benefits.map((benefit) => (
              <li>
                <Icon name="check" size={17} />
                {benefit}
              </li>
            ))}
          </ul>
          <a class="text-link" href={feature.href}>
            {feature.link}
            <Icon name="arrow" size={18} />
          </a>
        </div>
      </div>
    </section>
  ))}
  <Workflow />
  <section class="container section service-directory-section">
    <div class="section-title">
      <div>
        <p class="eyebrow">Start with the improvement</p>
        <h2>
          Different tools.
          <br />
          One connected approach.
        </h2>
      </div>
      <p>
        Some problems need a better report. Others need a workflow, a website or an application.
        Explore the service that fits the work you want to improve.
      </p>
    </div>
    <Directory />
  </section>
  <section class="human-section">
    <div class="container section person-row">
      <div class="person-tile">
        <span class="person-orbit" aria-hidden="true"></span>
        <span class="small-label">Independent specialist · Maidstone, Kent</span>
        <span class="initials">
          KS<span>.</span>
        </span>
        <div class="person-nameplate">
          <h3>Karol Songin</h3>
          <p>
            Operations & data analyst.
            <br />
            Hands-on developer.
          </p>
        </div>
        <div class="person-disciplines">
          <span>Understand</span>
          <Icon name="link" size={14} />
          <span>Build</span>
          <Icon name="link" size={14} />
          <span>Improve</span>
        </div>
      </div>
      <div class="person-copy">
        <p class="eyebrow">{experience.human.eyebrow}</p>
        <h2>{experience.human.heading}</h2>
        <p>{experience.human.body}</p>
        <p>{experience.human.second}</p>
        <a class="text-link" href="/about/">
          Meet Karol
          <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
  </section>
  <section class="process-section">
    <div class="container section">
      <div class="section-title">
        <div>
          <p class="eyebrow">A clear way forward</p>
          <h2>
            A useful first step.
            <br />A considered way to build it.
          </h2>
        </div>
        <a class="text-link" href="/how-it-works/">
          How projects work
          <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="process-grid">
        {process.paragraphs.map((text, i) => {
          const [title, body] = split(text);
          return (
            <article>
              <span class="process-number">0{i + 1}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
  <CTA />
</Base>
