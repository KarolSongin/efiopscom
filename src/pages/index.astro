---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Directory from '../components/Directory.astro';
import SystemVisual from '../components/SystemVisual.astro';
import Workflow from '../components/Workflow.astro';
import core from '../data/core.json';
const page = core.home;
const problems = page.sections[0];
const outcomes = page.sections[1];
const process = page.sections[5];
const split = (text: string) => {
  const dot = text.indexOf('. ');
  return [text.slice(0, dot + 1), text.slice(dot + 2)];
};
---

<Base title={page.seoTitle} description={page.metaDescription}>
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{page.eyebrow}</p>
          <h1>{page.h1}</h1>
          <p class="hero-lead">{page.lead}</p>
          <div class="hero-buttons">
            <a href="/contact/" class="button">
              Talk through your project{' '}
              <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 19L19 5M5 5h14v14" />
              </svg>
            </a>
            <a href="/services/" class="button secondary">
              Explore the services{' '}
              <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 4v16M5 13l7 7 7-7" />
              </svg>
            </a>
          </div>
          <p class="location">Based in Maidstone, Kent. Working with businesses across the UK.</p>
        </div>
        <SystemVisual />
      </div>
      <div class="hero-footer">
        <p>UNDERSTAND THE WORK. CONNECT THE PIECES.</p>
        <span>One specialist. Operational understanding. Hands-on development.</span>
      </div>
    </div>
  </section>
  <section class="container section">
    <div class="section-title">
      <div>
        <p class="eyebrow">Start with the problem</p>
        <h2>{problems.heading}</h2>
      </div>
    </div>
    <div class="problem-grid">
      {problems.paragraphs.map((text, i) => {
        const [title, body] = split(text);
        return (
          <article>
            <span class="index">0{i + 1}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        );
      })}
    </div>
  </section>
  <section class="outcomes">
    <div class="container section">
      <p class="eyebrow">The useful result</p>
      <h2>{outcomes.heading}</h2>
      <div class="outcome-grid">
        {outcomes.paragraphs.map((text, i) => {
          const [title, body] = split(text);
          return (
            <article>
              <div
                class:list={['outcome-art', i === 1 ? 'flow-art' : i === 2 ? 'web-art' : '']}
                aria-hidden="true"
              >
                {i === 0 ? (
                  <div class="bar-chart">
                    <i />
                    <i />
                    <i />
                    <i />
                  </div>
                ) : i === 1 ? (
                  <>
                    <span>▤</span>
                    <b>→</b>
                    <span>⇄</span>
                    <b>→</b>
                    <span>✓</span>
                  </>
                ) : (
                  <div>
                    <i />
                  </div>
                )}
              </div>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
  <section class="container section">
    <div class="section-title">
      <div>
        <p class="eyebrow">Ten services. One connected approach.</p>
        <h2>The right tool for the job.</h2>
      </div>
      <p>{page.blocks.Services[0]}</p>
    </div>
    <Directory />
  </section>
  <Workflow />
  <section class="container section person-row">
    <div class="person-tile">
      <span class="small-label">The person behind EFIops</span>
      <span class="initials">KS.</span>
      <h3>Karol Songin</h3>
      <p>
        Operations & data analyst.
        <br />
        Hands-on developer.
      </p>
    </div>
    <div class="person-copy">
      <p class="eyebrow">Business understanding, built in</p>
      <h2>Built with an understanding of the work behind the screen.</h2>
      <p>{page.blocks['Human expertise'][0]}</p>
      <p>
        <strong>{page.blocks['Human expertise'][1]}</strong>
      </p>
      <a class="text-link" href="/about/">
        Meet Karol{' '}
        <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 19L19 5M5 5h14v14" />
        </svg>
      </a>
    </div>
  </section>
  <section class="process-section">
    <div class="container section">
      <div class="section-title">
        <div>
          <p class="eyebrow">A clear way forward</p>
          <h2>{process.heading}</h2>
        </div>
        <a class="text-link" href="/how-it-works/">
          See how projects work{' '}
          <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 19L19 5M5 5h14v14" />
          </svg>
        </a>
      </div>
      <div class="process-grid">
        {process.paragraphs.map((text, i) => {
          const [title, body] = split(text);
          return (
            <article>
              <span class="index">0{i + 1}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
  <CTA />
</Base>
