---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { articles, insightsReleased } from '../../data/content';
import { site } from '../../config/site';
export async function getStaticPaths() {
  return (await insightsReleased())
    ? (await articles()).map((e) => ({ params: { slug: e.data.slug }, props: { page: e.data } }))
    : [];
}
const { page } = Astro.props;
const article = {
  '@type': 'Article',
  headline: page.title,
  description: page.description,
  author: { '@id': site.url + '/#karol' },
  datePublished: page.publishedDate,
  ...(page.substantiveUpdatedDate ? { dateModified: page.substantiveUpdatedDate } : {}),
  mainEntityOfPage: site.url + `/insights/${page.slug}/`,
};
---

<Base title={page.title + ' | EFIops'} description={page.description} article={article}>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/insights/">Insights</a>
      </nav>
      <p class="eyebrow">
        By {page.author} · {page.publishedDate}
      </p>
      <h1>{page.title}</h1>
      <p>{page.description}</p>
    </div>
  </section>
  <div class="container article-body">
    {page.sections.map((s) => (
      <section>
        <h2>{s.heading}</h2>
        <p>{s.body}</p>
      </section>
    ))}
    <section>
      <h2>Sources</h2>
      <ul>
        {page.sources.map((s) => (
          <li>
            <a href={s.url}>{s.label}</a>
          </li>
        ))}
      </ul>
    </section>
    <section>
      <h2>Related services</h2>
      {page.relatedServices.map((s) => (
        <a class="text-link" href={`/services/${s}/`}>
          {s.replaceAll('-', ' ')} ↗
        </a>
      ))}
    </section>
  </div>
  <CTA />
</Base>
