# Local preview and separately reviewed production configuration. Never commit real values.
BUILD_MODE=preview
CONTACT_ALLOWED_ORIGIN=http://localhost:4321
CONTACT_FROM=
CONTACT_TO=
RESEND_API_KEY=
# Local test only: success, failure or dashboard; ignored in production.
PREVIEW_CONTACT_MODE=

# Customer dashboard. Preview uses a clearly labelled local demo by default.
# Use ADMIN_MODE=supabase after following docs/admin-setup.md.
ADMIN_MODE=demo
ADMIN_ALLOWED_ORIGIN=http://localhost:4321
ADMIN_EMAIL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy key names SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are also supported.
# Production enquiry storage: supabase (otherwise the existing email provider is used).
CONTACT_STORAGE=
# To save test contact submissions in the local demo, set PREVIEW_CONTACT_MODE=dashboard.
