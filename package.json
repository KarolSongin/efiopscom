{
  "name": "efiopscom",
  "version": "1.0.0",
  "description": "EfiOps business websites, data and automation",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "preview": "node server/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "verify": "npm run check && npm run build && npm test && npm run test:browser",
    "build:launch": "node scripts/build.mjs --production --verify-contact"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarolSongin/efiopscom.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/KarolSongin/efiopscom/issues"
  },
  "homepage": "https://github.com/KarolSongin/efiopscom#readme",
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3"
  },
  "private": true
}
